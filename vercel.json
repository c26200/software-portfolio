{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    { "source": "/en/sobre", "destination": "/en/about", "permanent": true },
    {
      "source": "/en/proyectos/portfolio-mecatronica",
      "destination": "/en/projects/mechatronics-portfolio",
      "permanent": true
    },
    { "source": "/en/proyectos/:slug", "destination": "/en/projects/:slug", "permanent": true },
    {
      "source": "/en/blog/series-temporales-producto",
      "destination": "/en/blog/time-series-to-product",
      "permanent": true
    },
    {
      "source": "/en/blog/estado-local-react",
      "destination": "/en/blog/local-state-react",
      "permanent": true
    },
    {
      "source": "/en/blog/diseno-dashboards-react",
      "destination": "/en/blog/readable-dashboards-react",
      "permanent": true
    },
    {
      "source": "/en/blog/ia-en-tiempo-real",
      "destination": "/en/blog/real-time-ai",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/projects/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
